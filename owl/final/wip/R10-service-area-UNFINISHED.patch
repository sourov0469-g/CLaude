+<script>
+OWL.reg('arhero','2',function(root){
+  var svg = root.querySelector('svg'), fz = root.querySelector('.fz'), tip = root.querySelector('.tip'), msg = root.querySelector('.row p'), NS = 'http://www.w3.org/2000/svg';
+  var b = ''; for (var i = 0; i < 70; i++){ var x = 30 + i*13.6, y = 128 - (x - 6)/984*32, up = 70*Math.sin(Math.PI*Math.min(1, (x - 20)/960)) + 6, dn = 56*Math.sin(Math.PI*Math.min(1, (x - 20)/960)) + 4;
+    b += '<path d="M' + x.toFixed(1) + ' ' + y.toFixed(1) + ' l' + (14) + ' ' + (-up).toFixed(1) + ' M' + x.toFixed(1) + ' ' + y.toFixed(1) + ' l' + (16) + ' ' + dn.toFixed(1) + '" stroke="#C7871A" stroke-opacity=".45" stroke-width="1.4"/>'; }
+  svg.querySelector('.barbs').innerHTML = b;
+  var hs = svg.querySelector('.houses'), T = OWL.TOWNS, all = [];
+  T.forEach(function(t, i){ var x = 40 + i*(930/(T.length - 1)), base = 128 - (x - 6)/984*32, side = i % 2 ? 1 : -1, y = base + side*(22 + (i % 4)*7);
+    var g = document.createElementNS(NS, 'g'); g.setAttribute('class', 'hs'); g.setAttribute('tabindex', '0'); g.setAttribute('role', 'img'); g.setAttribute('aria-label', t[0]);
+    g.innerHTML = '<path d="M' + (x - 8) + ' ' + (y + 6) + ' v-8 l8 -7 8 7 v8z" fill="' + (t[1] < 0 ? '#17111D' : '#8E5A12') + '"/>';
+    function show(){ all.forEach(function(o){ o.classList.toggle('on', o === g); }); var r = fz.getBoundingClientRect(), s = r.width/1000; tip.style.left = (x*s) + 'px'; tip.style.top = (y*s) + 'px'; tip.textContent = t[0]; tip.classList.add('on');
+      msg.textContent = t[1] < 0 ? 'Shoreview is home base.' : 'Yes, we serve ' + t[0] + '.'; }
+    g.addEventListener('mouseenter', show); g.addEventListener('focus', show); g.addEventListener('click', show);
+    g.addEventListener('mouseleave', function(){ tip.classList.remove('on'); }); g.addEventListener('blur', function(){ tip.classList.remove('on'); });
+    hs.appendChild(g); all.push(g); });
+});
+</script>
