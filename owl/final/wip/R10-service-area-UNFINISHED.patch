+/* Owl's confirmed 29 towns, grouped by rough distance from Shoreview (0 near, 1 middle, 2 farther), with rough compass bearing */
+OWL.TOWNS = [['Shoreview',-1,0],['North Oaks',0,0],['Lino Lakes',0,12],['White Bear Lake',0,68],['Vadnais Heights',0,110],['Maplewood',0,148],['Little Canada',0,166],['Roseville',0,192],['New Brighton',0,224],['Fridley',0,238],['Arden Hills',0,250],['Mounds View',0,275],['Blaine',0,318],
+ ['Forest Lake',1,18],['Stillwater',1,98],['Oakdale',1,120],['Woodbury',1,140],['Saint Paul',1,176],['Minneapolis',1,214],['Coon Rapids',1,298],
+ ['Eagan',2,168],['Apple Valley',2,182],['Burnsville',2,196],['Bloomington',2,206],['Edina',2,218],['Eden Prairie',2,226],['Minnetonka',2,236],['Plymouth',2,252],['Maple Grove',2,284]];
+OWL.HOME = {addr:'1000 County Rd E #230, Shoreview, MN 55126', map:'https://www.google.com/maps/search/?api=1&query=1000%20County%20Rd%20E%20%23230%2C%20Shoreview%2C%20MN%2055126'};
+/* office hours Mon–Sat 08:00–18:00, Minnesota time */
+OWL.openNow = function(){
+  var p = {}; try { new Intl.DateTimeFormat('en-US', {timeZone:'America/Chicago', weekday:'short', hour:'2-digit', minute:'2-digit', hourCycle:'h23'}).formatToParts(new Date()).forEach(function(x){ p[x.type] = x.value; }); } catch(e){ return null; }
+  var days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'], d = days.indexOf(p.weekday), h = +p.hour + (+p.minute)/60;
+  return {day:d, hour:h, open: d >= 1 && d <= 6 && h >= 8 && h < 18, label:p.weekday + ' ' + p.hour + ':' + p.minute};
+};
