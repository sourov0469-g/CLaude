+.ah2 .hs:hover path,.ah2 .hs.on path{fill:#17111D;transform:scale(1.35)}
+.ah2 .hs:focus{outline:none}.ah2 .hs:focus-visible path{stroke:#17111D;stroke-width:2}
+.ah2 .tip{position:absolute;transform:translate(-50%,-130%);background:var(--ink);color:var(--cream);font-weight:700;font-size:14px;padding:7px 12px;border-radius:999px;white-space:nowrap;pointer-events:none;opacity:0;transition:opacity .2s}
+.ah2 .tip.on{opacity:1}
+.ah2 .facts{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:clamp(16px,3vw,28px);text-align:center}
+.ah2 .facts div{padding:18px;border-radius:18px;background:var(--cream)}
+.ah2 .facts svg{width:26px;height:26px;color:#8E5A12}
+.ah2 .facts b{display:block;font-size:19px;margin-top:6px}
+.ah2 .facts span{font-size:16px;color:var(--ink-70)}
+.ah2 .row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px;margin-top:22px;text-align:left}
+.ah2 .row p{font-weight:700;font-size:18px;min-height:28px}
+@media (max-width:760px){.ah2 .facts{grid-template-columns:1fr}}
