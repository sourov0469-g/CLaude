 "heroOuter": "<section class=\"hero\" id=\"top\"> <div class=\"hero__media\"> <!-- The film, re-encoded for the web from the 20 MB master. HEVC first for the browsers that take it, H.264 for the rest, no audio track on either and the moov atom up front so both start on the first bytes. The poster is frame one of the same film, so nothing jumps when playback begins. Tracked in WORKLOG.md. --> <!-- preload=\"auto\", not \"metadata\": chrome.js holds this paused until the splash lifts at 2.16s, and the visitor then has a consent banner to answer, so there is a clear few seconds of otherwise idle time to buffer in. The poster carries the first paint and is preloaded above at high priority, so this competes with nothing that matters. --> <video class=\"hero__bg\" autoplay=\"\" muted=\"\" loop=\"\" playsinline=\"\" preload=\"auto\" poster=\"/assets/hero-poster.jpg\"> <source src=\"/assets/hero-video-hevc.mp4\" type=\"video/mp4; codecs=&quot;hvc1&quot;\"> <source src=\"/assets/hero-video.mp4\" type=\"video/mp4\"> </video> </div> <div class=\"hero__content\"> <h1 class=\"hero__title lb-fade is-lit\"> <span class=\"line\"><span>Speed<br class=\"hero__br\"> of<br class=\"hero__br\"> <em>Lightness</em><sup class=\"tm\">™</sup></span></span> </h1> </div> <a class=\"hero__scroll\" href=\"#top\" id=\"heroScroll\" aria-label=\"Scroll down\"> <svg viewBox=\"0 0 24 34\" width=\"22\" height=\"31\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 2v26\" stroke=\"currentColor\" stroke-width=\"1.1\" stroke-linecap=\"round\"></path><path d=\"M4 20l8 9 8-9\" stroke=\"currentColor\" stroke-width=\"1.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg> </a> </section>",
