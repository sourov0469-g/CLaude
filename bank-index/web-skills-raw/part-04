      with:
        script: |
          const fs = require('fs')

          if (fs.existsSync('reports/eslint-report.json')) {
            const report = JSON.parse(fs.readFileSync('reports/eslint-report.json', 'utf8'))

            let comment = '## ESLint Results\n\n'
            let totalErrors = 0
            let totalWarnings = 0

            report.forEach(file => {
