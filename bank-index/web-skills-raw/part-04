.nav-items {
  display: flex;
  gap: 1rem;
}

.nav-item {
  flex: 1;  /* Equal widths */
}

/* Sidebar + main content */
.layout {
  display: flex;
  gap: 2rem;
}

.sidebar {
  flex: 0 0 280px;  /* Fixed 280px, no growing or shrinking */
}

