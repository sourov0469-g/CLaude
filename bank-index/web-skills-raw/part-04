function detectTextDirection(text) {
  // RTL characters regex
  const rtlChars = /[\u0590-\u083F]|[\u08A0-\u08FF]|[\uFB1D-\uFDFF]|[\uFE70-\uFEFF]/

  // Find first strongly directional character
  for (let char of text) {
