#

##### React/Next.js

```tsx
// components/footer.tsx

  return (
    <footer>
      <nav aria-label="Legal links">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/cookies">Cookie Settings</a>
      </nav>
    </footer>
  )
