  children: React.ReactNode
  speed?: number // 0 to 1, default 0.5
  className?: string
}

function Parallax({ children, speed = 0.5, className }: ParallaxProps) {
  const [offset, setOffset] = useState(0)
  const prefersReducedMotion = useReducedMotion()
  const ref = useRef
      {children}
    </div>
  )
