.container {
  width: 90%;
  max-width: 1200px;
  margin-inline: auto;
}

/* ✅ min/max for sensible constraints */
.card {
  width: min(100%, 400px);   /* never wider than parent or 400px */
  min-height: max(200px, 30vh);
}

/* ✅ Full viewport sections */
