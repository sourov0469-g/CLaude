type RouteHandler = (req: Request, ...args: unknown[]) => Promise {
    const requestId = randomUUID()

    try {
      return await handler(req, ...args)
    } catch (error) {
      const isProd = process.env.NODE_ENV === 'production'

      if (isApiError(error) && error.isOperational) {
