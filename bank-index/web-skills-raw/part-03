// ---------- 共享编舞：16 个时代用同一套动作曲线，各自用自己的画法画出来 ----------
// lt = 本段局部时间（秒）。返回 0..1 或角度，时代代码按需取用。
// 端杯循环（全片时间）：2.4s 一轮——0.9s 举到嘴边、停 0.7s 喝、0.8s 放回
P.cupCycle = (t, period = 2.4) => { const q = ((t % period) + period) % period;
