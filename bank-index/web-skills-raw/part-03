};
// 粒子：给定种子与时间，返回确定的粒子位置（飘落/上浮）
P.particles = (n, seed, t, { x0 = 0, x1 = W, y0 = -40, y1 = H + 40, speed = 80, drift = 30, life = 6 } = {}) => {
  const r = rng(seed), out = [];
