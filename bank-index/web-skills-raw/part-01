// ---------- Conversión de color ----------
const clamp = (x, a = 0, b = 1) => Math.min(b, Math.max(a, x));
const srgbALineal = (c) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
const linealASrgb = (c) => (c <= 0.0031308 ? 12.92 * c : 1.055 * c ** (1 / 2.4) - 0.055);

function oklabARgb(L, a, b) {
