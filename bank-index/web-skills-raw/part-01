const maxDim = Math.max(size.x, size.y, size.z);
if (!Number.isFinite(maxDim) || maxDim <= 0) throw new Error("Empty or invalid bounds");
geometry.scale(1 / maxDim, 1 / maxDim, 1 / maxDim);
