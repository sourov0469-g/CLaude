    linealASrgb(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s),
    linealASrgb(-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s),
    linealASrgb(-0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s),
